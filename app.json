{
  "expo": {
    "name": "Biographia",
    "slug": "diamondsaar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "biographiamobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "pro.ssod.biographia",
      "versionCode": 14,
      "permissions": ["android.permission.REQUEST_INSTALL_PACKAGES", "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"],
      "adaptiveIcon": {
        "backgroundColor": "#1e293b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1e293b"
        }
      ],
      "expo-secure-store",
      "expo-video",
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": "Приложению нужен доступ к микрофону, чтобы надиктовать голосовую заметку."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Приложению нужен доступ, чтобы сохранить файл в галерею телефона.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5aa4601c-4f9d-45d2-bead-323413e6951b"
      }
    },
    "owner": "diamondsaars-team"
  }
}
